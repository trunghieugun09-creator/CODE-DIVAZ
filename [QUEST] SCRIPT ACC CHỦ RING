local function updList()
    for _,v in sf:GetChildren() do if v:IsA("Frame") then v:Destroy() end end
    for _,pl in Players:GetPlayers() do
        if pl~=player then
            local sel=(vai=="chu" and mt==pl) or (vai=="clone" and chu==pl)
            local d=Instance.new("Frame") d.Size=UDim2.new(1,-4,0,42) d.BackgroundColor3=sel and Color3.fromRGB(80,20,130) or Color3.fromRGB(28,28,38) d.BorderSizePixel=0 d.Parent=sf
            Instance.new("UICorner",d).CornerRadius=UDim.new(0,7)
            local av=Instance.new("ImageLabel") av.Size=UDim2.new(0,30,0,30) av.Position=UDim2.new(0,5,0.5,-15) av.BackgroundTransparency=1 av.Parent=d Instance.new("UICorner",av).CornerRadius=UDim.new(0,15)
            if daLayAvt[pl.UserId] then av.Image=daLayAvt[pl.UserId]
            else task.spawn(function() pcall(function() local img=Players:GetUserThumbnailAsync(pl.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size100x100) daLayAvt[pl.UserId]=img av.Image=img end) end) end
            local tn=Instance.new("TextLabel") tn.Size=UDim2.new(0,130,0,16) tn.Position=UDim2.new(0,42,0,4) tn.Text=pl.DisplayName tn.TextColor3=Color3.new(1,1,1) tn.Font=Enum.Font.GothamBold tn.TextSize=11 tn.BackgroundTransparency=1 tn.TextXAlignment=Enum.TextXAlignment.Left tn.Parent=d
            local ud=Instance.new("TextLabel") ud.Size=UDim2.new(0,130,0,12) ud.Position=UDim2.new(0,42,0,22) ud.Text="UID: "..pl.UserId ud.TextColor3=Color3.fromRGB(140,140,160) ud.Font=Enum.Font.Gotham ud.TextSize=8 ud.BackgroundTransparency=1 ud.TextXAlignment=Enum.TextXAlignment.Left ud.Parent=d
            local ref=pl d.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.Touch or inp.UserInputType==Enum.UserInputType.MouseButton1 then if vai=="chu" then mt=ref else chu=ref end updList() end end)
        end
    end
    sf.CanvasSize=UDim2.new(0,0,0,lay.AbsoluteContentSize.Y+4)
end
