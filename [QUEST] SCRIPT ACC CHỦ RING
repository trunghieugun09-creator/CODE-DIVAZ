-- ==================== RING + SPAWN CỐ ĐỊNH ====================
local function dichSpawn()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" or obj.Name == "Spawn1" or obj.Name == "Spawn2" then
            if obj.ClassName == "SpawnLocation" then obj.Duration = 0 end
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj.ClassName == "SpawnLocation" then
                obj.CFrame = CFrame.new(TOADO_CHUNG) obj.Velocity = Vector3.zero obj.Anchored = true
            end
        end
    end
end
RunService.RenderStepped:Connect(dichSpawn)

RunService.RenderStepped:Connect(function()
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - TOADO_CHUNG).Magnitude > 5 then
            hrp.CFrame = CFrame.new(TOADO_CHUNG) hrp.Velocity = Vector3.zero
        end
    end
end)

player.CharacterAdded:Connect(function(char)
    task.wait(0.1) local hrp = char:WaitForChild("HumanoidRootPart",5)
    if hrp then hrp.CFrame = CFrame.new(TOADO_CHUNG) end
    dichSpawn()
end)

workspace.DescendantAdded:Connect(function(obj)
    if obj.ClassName == "SpawnLocation" or obj.Name == "Spawn1" or obj.Name == "Spawn2" then
        if obj.ClassName == "SpawnLocation" then obj.Duration = 0 end
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj.ClassName == "SpawnLocation" then
            obj.Anchored = true obj.CFrame = CFrame.new(TOADO_CHUNG)
        end
    end
end)

-- ==================== GỬI TÍN HIỆU ẨN ====================
local function guiTinHieuAn()
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function() hrp.CFrame = CFrame.new(TOADO_CHUNG.X, TIN_HIEU_Y, TOADO_CHUNG.Z) end)
            task.wait(0.15)
            pcall(function() hrp.CFrame = CFrame.new(TOADO_CHUNG) end)
        end
    end
end

-- ==================== COMBAT ====================
local function bamPhim(key)
    pcall(function() VirtualInputManager:SendKeyEvent(true,key,false,game) task.wait(0.01) VirtualInputManager:SendKeyEvent(false,key,false,game) end)
end
local function layToolUuTien()
    local c=player.Character local bp=player:FindFirstChild("Backpack")
    if c then for _,v in pairs(c:GetChildren()) do if v:IsA("Tool") and string.find(string.lower(v.Name),"nails") then return v end end end
    if bp then for _,v in pairs(bp:GetChildren()) do if v:IsA("Tool") and string.find(string.lower(v.Name),"nails") then return v end end end
    if c then for _,v in pairs(c:GetChildren()) do if v:IsA("Tool") and v.Name=="Fist" then return v end end end
    if bp then local f=bp:FindFirstChild("Fist") if f then return f end end
    return nil
end
local function trangBiVuKhi()
    local c=player.Character if not c then return false end
    local h=c:FindFirstChild("Humanoid") if not h then return false end
    local t=layToolUuTien() if t and t.Parent==c then return true end
    if t and t.Parent~=c then h:EquipTool(t) task.wait(0.02) return true end
    return false
end
local function danh() trangBiVuKhi() local c=player.Character if c then local t=layToolUuTien() if t and t:IsA("Tool") then pcall(function() t:Activate() end) end end end
local function tom() bamPhim(Enum.KeyCode.G) end
local function stomp() bamPhim(Enum.KeyCode.E) danh() end
local function dungDiChuyen() dangDiChuyen=false if tacVuDiChuyen then task.cancel(tacVuDiChuyen) tacVuDiChuyen=nil end end
local function diToiMucTieu(dich)
    if tacVuDiChuyen then task.cancel(tacVuDiChuyen) end dangDiChuyen=true
    tacVuDiChuyen=task.spawn(function()
        local c,h,r=player.Character,nil,nil if c then h=c:FindFirstChild("Humanoid") r=c:FindFirstChild("HumanoidRootPart") end
        if not h or not r then dangDiChuyen=false return end h.WalkSpeed=tocDoChay
        while dangHoatDong and dangDiChuyen and r and r.Parent and dich and dich.Parent do
            if not mucTieu or not mucTieu.Character then break end
            local d2=mucTieu.Character:FindFirstChild("HumanoidRootPart") if not d2 then break end
            if (r.Position-d2.Position).Magnitude<=tamDanh then break end
            r.CFrame=CFrame.lookAt(r.Position,Vector3.new(d2.Position.X,r.Position.Y,d2.Position.Z)) h:MoveTo(d2.Position) task.wait(0.05)
        end
        dangDiChuyen=false tacVuDiChuyen=nil
    end)
end
local function luiRa(dich)
    if tacVuDiChuyen then task.cancel(tacVuDiChuyen) end dangDiChuyen=true
    tacVuDiChuyen=task.spawn(function()
        local c,h,r=player.Character,nil,nil if c then h=c:FindFirstChild("Humanoid") r=c:FindFirstChild("HumanoidRootPart") end
        if not h or not r then dangDiChuyen=false return end h.WalkSpeed=tocDoChay
        local huongLui=(r.Position-dich.Position).Unit if huongLui.Magnitude<0.01 then huongLui=Vector3.new(0,0,-1) end
        local vtLui=r.Position+huongLui*tamLui
        while dangHoatDong and dangDiChuyen and r and r.Parent do
            if (r.Position-vtLui).Magnitude<=0.5 then break end h:MoveTo(vtLui) task.wait(0.05)
        end
        dangDiChuyen=false tacVuDiChuyen=nil
    end)
end
local function vongLapCombat()
    while dangHoatDong do task.wait(0.05)
        if not mucTieu then continue end
        local tc=mucTieu.Character if not tc then continue end
        local dich=tc:FindFirstChild("HumanoidRootPart") local mauDich=tc:FindFirstChild("Humanoid")
        if not dich or not mauDich or mauDich.Health<=0 then continue end
        local c,_,r=player.Character,nil,nil if c then r=c:FindFirstChild("HumanoidRootPart") end
        if not r then continue end
        local kc=(r.Position-dich.Position).Magnitude
        if mauDich.Health<nguongMau then
            if kc>tamDanh then dangDanh=true if not dangDiChuyen then diToiMucTieu(dich) end
            elseif kc<1 then dangDanh=true if not dangDiChuyen then luiRa(dich) end
            else dungDiChuyen() dangDanh=true r.CFrame=CFrame.lookAt(r.Position,Vector3.new(dich.Position.X,r.Position.Y,dich.Position.Z)) stomp() task.wait(0.02) end
        else
            if kc>tamDanh then dangDanh=true if not dangDiChuyen then diToiMucTieu(dich) end
            elseif kc<1 then dangDanh=true if not dangDiChuyen then luiRa(dich) end
            else dungDiChuyen() dangDanh=true r.CFrame=CFrame.lookAt(r.Position,Vector3.new(dich.Position.X,r.Position.Y,dich.Position.Z)) danh() tom() task.wait(0.02) end
        end
    end
end

-- ==================== AUTO DUEL LOOP ====================
local function guiRemoteDuel()
    if not mucTieu then return end
    local args={[1]={["TargetUserId"]=mucTieu.UserId,["Event"]="DuelRequest",["Action"]="Challenge"}}
    pcall(function() Remote:FireServer(unpack(args)) end)
end

local function theoDoiMauVaLap()
    task.spawn(function()
        while dangHoatDong do
            if not mucTieu then task.wait(1) continue end
            local tc=mucTieu.Character
            if not tc then task.wait(1) continue end
            local mauDich=tc:FindFirstChild("Humanoid")
            if mauDich and mauDich.Health<=0 then
                dangDanh=false dungDiChuyen()
                task.wait(3)
                guiTinHieuAn() -- Gửi tín hiệu ẩn cho clone biết sắp gửi remote
                task.wait(0.2)
                guiRemoteDuel()
                task.wait(4)
            end
            task.wait(0.3)
        end
    end)
end

local function batDauDuel()
    if not mucTieu then return end
    guiTinHieuAn()
    task.wait(0.2)
    guiRemoteDuel()
    task.wait(4)
    task.spawn(vongLapCombat)
    theoDoiMauVaLap()
end

