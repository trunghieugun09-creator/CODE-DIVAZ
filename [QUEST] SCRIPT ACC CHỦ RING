local listUpdating = false

local function updatePlayerList()
    if listUpdating then return end
    listUpdating = true
    
    for _, v in sf:GetChildren() do 
        if v:IsA("Frame") then 
            v:Destroy() 
        end 
    end
    
    local players = Players:GetPlayers()
    local hasPlayers = false
    
    for _, pl in ipairs(players) do
        if pl ~= player then
            hasPlayers = true
            local isSelected = (vai == "chu" and mt == pl) or (vai == "clone" and chu == pl)
            
            local d = Instance.new("Frame") 
            d.Size = UDim2.new(1, -4, 0, 42) 
            d.BackgroundColor3 = isSelected and Color3.fromRGB(80, 20, 130) or Color3.fromRGB(28, 28, 38) 
            d.BorderSizePixel = 0 
            d.Parent = sf
            Instance.new("UICorner", d).CornerRadius = UDim.new(0, 7)
            
            local av = Instance.new("ImageLabel") 
            av.Size = UDim2.new(0, 30, 0, 30) 
            av.Position = UDim2.new(0, 5, 0.5, -15) 
            av.BackgroundTransparency = 1 
            av.Parent = d
            Instance.new("UICorner", av).CornerRadius = UDim.new(0, 15)
            pcall(function() 
                av.Image = Players:GetUserThumbnailAsync(pl.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) 
            end)
            
            local tn = Instance.new("TextLabel") 
            tn.Size = UDim2.new(0, 130, 0, 16) 
            tn.Position = UDim2.new(0, 42, 0, 4) 
            tn.Text = pl.DisplayName 
            tn.TextColor3 = Color3.new(1, 1, 1) 
            tn.Font = Enum.Font.GothamBold 
            tn.TextSize = 11 
            tn.BackgroundTransparency = 1 
            tn.TextXAlignment = Enum.TextXAlignment.Left 
            tn.Parent = d
            
            local ud = Instance.new("TextLabel") 
            ud.Size = UDim2.new(0, 130, 0, 12) 
            ud.Position = UDim2.new(0, 42, 0, 22) 
            ud.Text = "UID: " .. pl.UserId 
            ud.TextColor3 = Color3.fromRGB(140, 140, 160) 
            ud.Font = Enum.Font.Gotham 
            ud.TextSize = 8 
            ud.BackgroundTransparency = 1 
            ud.TextXAlignment = Enum.TextXAlignment.Left 
            ud.Parent = d
            
            local ref = pl
            d.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.Touch or inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    if vai == "chu" then 
                        mt = ref 
                    else 
                        chu = ref 
                    end
                    updatePlayerList()
                end
            end)
        end
    end
    
    if not hasPlayers then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, 0, 0, 30)
        empty.Text = "⚠️ Không có người chơi"
        empty.TextColor3 = Color3.fromRGB(200, 200, 200)
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.BackgroundTransparency = 1
        empty.Parent = sf
    end
    
    sf.CanvasSize = UDim2.new(0, 0, 0, math.max(lay.AbsoluteContentSize.Y + 4, 200))
    listUpdating = false
end

