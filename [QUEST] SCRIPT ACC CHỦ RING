-- ==================== COMBAT (OPTIMIZED) ====================
local function bam(key)
    pcall(function() 
        VirtualInputManager:SendKeyEvent(true, key, false, game) 
        task.wait(0.01) 
        VirtualInputManager:SendKeyEvent(false, key, false, game) 
    end)
end

local function layTool()
    local c = player.Character 
    local bp = player:FindFirstChild("Backpack")
    if c then 
        for _, v in c:GetChildren() do 
            if v:IsA("Tool") and (v.Name:lower():find("nails") or v.Name == "Fist") then 
                return v 
            end 
        end 
    end
    if bp then 
        for _, v in bp:GetChildren() do 
            if v:IsA("Tool") and (v.Name:lower():find("nails") or v.Name == "Fist") then 
                return v 
            end 
        end 
    end
    return nil
end

local function danh()
    local t = layTool()
    if t then
        if t.Parent ~= player.Character then
            local h = player.Character and player.Character:FindFirstChild("Humanoid")
            if h then 
                pcall(function() h:EquipTool(t) end)
                task.wait(0.02) 
            end
        end
        pcall(function() t:Activate() end)
    end
end

local function tom() 
    pcall(function() bam(Enum.KeyCode.G) end) 
end

local function stomp() 
    pcall(function() 
        bam(Enum.KeyCode.E) 
        task.wait(0.05)
        danh() 
    end) 
end

local function dungDi() 
    dangDi = false 
    if tvuDi then 
        task.cancel(tvuDi) 
        tvuDi = nil 
    end 
end

local function diDen(dich)
    dungDi() 
    dangDi = true
    tvuDi = task.spawn(function()
        local c = player.Character
        local h = c and c:FindFirstChild("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not r then dangDi = false return end
        
        h.WalkSpeed = 20
        local count = 0
        while chay and dangDi and r and r.Parent and dich and dich.Parent do
            count = count + 1
            if count > 100 then break end
            local dist = (r.Position - dich.Position).Magnitude
            if dist <= 4 then break end
            
            pcall(function()
                r.CFrame = CFrame.lookAt(r.Position, Vector3.new(dich.Position.X, r.Position.Y, dich.Position.Z))
                h:MoveTo(dich.Position)
            end)
            task.wait(0.05)
        end
        dangDi = false 
        tvuDi = nil
    end)
end

local function lui(dich)
    dungDi() 
    dangDi = true
    tvuDi = task.spawn(function()
        local c = player.Character
        local h = c and c:FindFirstChild("Humanoid")
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not h or not r then dangDi = false return end
        
        h.WalkSpeed = 20
        local huong = (r.Position - dich.Position).Unit
        if huong.Magnitude < 0.01 then huong = Vector3.new(0, 0, -1) end
        local vt = r.Position + huong * 3
        
        local count = 0
        while chay and dangDi and r and r.Parent do
            count = count + 1
            if count > 100 then break end
            if (r.Position - vt).Magnitude <= 0.5 then break end
            
            pcall(function() h:MoveTo(vt) end)
            task.wait(0.05)
        end
        dangDi = false 
        tvuDi = nil
    end)
end

local function combat()
    local lastAttack = 0
    local attackCooldown = 0.2
    
    while chay do 
        task.wait(0.1)
        
        local dt = vai == "chu" and mt or chu
        if not dt or not dt.Character then 
            continue 
        end
        
        local dich = dt.Character:FindFirstChild("HumanoidRootPart")
        local mau = dt.Character:FindFirstChild("Humanoid")
        if not dich or not mau or mau.Health <= 0 then 
            continue 
        end
        
        local r = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not r then 
            continue 
        end
        
        local kc = (r.Position - dich.Position).Magnitude
        local now = tick()
        
        if now - lastAttack < attackCooldown then
            continue
        end
        
        if mau.Health < 3 then
            if kc > 4 then 
                dangDanh = true 
                if not dangDi then diDen(dich) end
            elseif kc < 1 then 
                dangDanh = true 
                if not dangDi then lui(dich) end
            else 
                dungDi() 
                dangDanh = true 
                pcall(stomp) 
                lastAttack = now
            end
        else
            if kc > 4 then 
                dangDanh = true 
                if not dangDi then diDen(dich) end
            elseif kc < 1 then 
                dangDanh = true 
                if not dangDi then lui(dich) end
            else 
                dungDi() 
                dangDanh = true 
                pcall(danh) 
                pcall(tom)
                lastAttack = now
            end
        end
    end
end

