-- ==================== TRONG ZONE ====================
local function trongZone(pl)
    local c = pl and pl.Character
    if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos = hrp.Position
    for i = 1, 3 do
        local ring = workspace:FindFirstChild("Ring" .. i)
        if ring and ring:IsA("Model") then
            for _, part in ipairs(ring:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("MeshPart") then
                    local dist = (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(part.Position.X, 0, part.Position.Z)).Magnitude
                    if dist <= ZONE_R then return true end
                end
            end
        end
    end
    return false
end

-- ==================== REMOTE ====================
local function guiChallenge()
    if not mt then return end
    local args = {[1] = {["TargetUserId"] = mt.UserId, ["Event"] = "DuelRequest", ["Action"] = "Challenge"}}
    DuelRemote:FireServer(unpack(args))
end
local function guiAccept()
    if not chu then return end
    local args = {[1] = {["ChallengerUserId"] = chu.UserId, ["Event"] = "DuelRequest", ["Action"] = "Accept"}}
    DuelRemote:FireServer(unpack(args))
end

-- SỬA bugXuongVoid: Teleport xuống -1500, lặp 20 lần liên tục để chống redirect
local function bugXuongVoid()
    for i = 1, 20 do
        local c = player.Character
        if c then
            local hrp = c:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    hrp.Anchored = false
                    hrp.CFrame = CFrame.new(hrp.Position.X, -1500, hrp.Position.Z)
                    hrp.Velocity = Vector3.new(0, -10000, 0)
                end)
            end
        end
        task.wait(0.01)
    end
end

-- ==================== VÒNG LẶP ====================
local function vongLapClone()
    while chay do
        if not chu then task.wait(0.3) daBug = false continue end
        if trongZone(chu) then
            if not daBug then task.spawn(bugXuongVoid) daBug = true end
            local c = player.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                local hrp = c:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Position.Y > -50 then task.spawn(bugXuongVoid) end
            end
        else
            daBug = false
            if tick() - lastAccept >= 2 then guiAccept() lastAccept = tick() end
        end
        task.wait(0.05)
    end
end

local function vongLapChu()
    while chay do
        if not mt then task.wait(0.3) continue end
        if trongZone(player) then task.wait(0.3)
        elseif tick() - lastChallenge >= 3 then guiChallenge() lastChallenge = tick() end
        task.wait(0.05)
    end
end

