local function drag(k)
    local keo,dbd,vbd=nil,nil,nil
    k.InputBegan:Connect(function(inp) if inp.UserInputType==Enum.UserInputType.Touch or inp.UserInputType==Enum.UserInputType.MouseButton1 then if keo then return end keo=inp dbd=inp.Position vbd=k.Position end end)
    UIS.InputEnded:Connect(function(inp) if inp==keo then keo,dbd,vbd=nil,nil,nil end end)
    UIS.InputChanged:Connect(function(inp) if inp==keo then local d=inp.Position-dbd k.Position=UDim2.new(vbd.X.Scale,vbd.X.Offset+d.X,vbd.Y.Scale,vbd.Y.Offset+d.Y) end end)
end
