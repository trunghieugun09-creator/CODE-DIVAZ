-- ==================== RING CỐ ĐỊNH (CHỈ KHI VÀO RING) ====================
local function dangORing()
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Spawn1" or obj.Name == "Spawn2" then
            if obj:IsA("BasePart") or obj:IsA("MeshPart") then
                if (hrp.Position - obj.Position).Magnitude < VIPHA_SPAWN then return true end
            end
        end
    end
    return false
end

local function dichSpawn()
    if not dangORing() then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" or obj.Name == "Spawn1" or obj.Name == "Spawn2" then
            if obj.ClassName == "SpawnLocation" then obj.Duration = 0 end
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj.ClassName == "SpawnLocation" then
                obj.CFrame = CFrame.new(TOADO_CHUNG) obj.Velocity = Vector3.zero obj.Anchored = true
            end
        end
    end
end
RunService.RenderStepped:Connect(dichSpawn)

RunService.RenderStepped:Connect(function()
    if not dangORing() then return end
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
