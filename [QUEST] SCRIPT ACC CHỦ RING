local function theoDoiMauVaLap()
    task.spawn(function()
        while dangHoatDong and vaiTro=="chu" do
            if not mucTieu then task.wait(1) continue end
            local tc=mucTieu.Character
            if not tc then task.wait(1) continue end
            local mauDich=tc:FindFirstChild("Humanoid")
            if mauDich and mauDich.Health<=0 then
                dangDanh=false dungDiChuyen()
                task.wait(3)
                guiTinHieuAn()
                task.wait(0.2)
                guiChallenge()
                task.wait(4)
            end
            task.wait(0.3)
        end
    end)
end

