-- ==================== COMBAT ====================
local function bam(key)
    pcall(function() VirtualInputManager:SendKeyEvent(true,key,false,game) task.wait(0.01) VirtualInputManager:SendKeyEvent(false,key,false,game) end)
end
local function layTool()
    local c=player.Character local bp=player:FindFirstChild("Backpack")
    if c then for _,v in c:GetChildren() do if v:IsA("Tool") and (v.Name:lower():find("nails") or v.Name=="Fist") then return v end end end
    if bp then for _,v in bp:GetChildren() do if v:IsA("Tool") and (v.Name:lower():find("nails") or v.Name=="Fist") then return v end end end
    return nil
end
local function danh()
    local t=layTool()
    if t then if t.Parent~=player.Character then local h=player.Character and player.Character:FindFirstChild("Humanoid") if h then h:EquipTool(t) task.wait(0.02) end end pcall(function() t:Activate() end) end
end
local function tom() bam(Enum.KeyCode.G) end
local function stomp() bam(Enum.KeyCode.E) danh() end
local function dungDi() dangDi=false if tvuDi then task.cancel(tvuDi) tvuDi=nil end end
local function diDen(dich)
    dungDi() dangDi=true tvuDi=task.spawn(function()
        local c,h,r=player.Character,nil,nil if c then h=c:FindFirstChild("Humanoid") r=c:FindFirstChild("HumanoidRootPart") end
        if not h or not r then dangDi=false return end h.WalkSpeed=20
        while chay and dangDi and r and r.Parent and dich and dich.Parent do
            if (r.Position-dich.Position).Magnitude<=4 then break end
            r.CFrame=CFrame.lookAt(r.Position,Vector3.new(dich.Position.X,r.Position.Y,dich.Position.Z)) h:MoveTo(dich.Position) task.wait(0.05)
        end dangDi=false tvuDi=nil
    end)
end
local function lui(dich)
    dungDi() dangDi=true tvuDi=task.spawn(function()
        local c,h,r=player.Character,nil,nil if c then h=c:FindFirstChild("Humanoid") r=c:FindFirstChild("HumanoidRootPart") end
        if not h or not r then dangDi=false return end h.WalkSpeed=20
        local huong=(r.Position-dich.Position).Unit if huong.Magnitude<0.01 then huong=Vector3.new(0,0,-1) end
        local vt=r.Position+huong*3
        while chay and dangDi and r and r.Parent do if (r.Position-vt).Magnitude<=0.5 then break end h:MoveTo(vt) task.wait(0.05) end
        dangDi=false tvuDi=nil
    end)
end
local function combat()
    while chay do task.wait(0.05)
        local dt=vai=="chu" and mt or chu
        if not dt or not dt.Character then continue end
        local dich=dt.Character:FindFirstChild("HumanoidRootPart") local mau=dt.Character:FindFirstChild("Humanoid")
        if not dich or not mau or mau.Health<=0 then continue end
        local r=player.Character and player.Character:FindFirstChild("HumanoidRootPart") if not r then continue end
        local kc=(r.Position-dich.Position).Magnitude
        if mau.Health<3 then if kc>4 then dangDanh=true if not dangDi then diDen(dich) end elseif kc<1 then dangDanh=true if not dangDi then lui(dich) end else dungDi() dangDanh=true stomp() end
        else if kc>4 then dangDanh=true if not dangDi then diDen(dich) end elseif kc<1 then dangDanh=true if not dangDi then lui(dich) end else dungDi() dangDanh=true danh() tom() end end
    end
end

-- ==================== REMOTE (ĐÚNG ĐỊNH DẠNG) ====================
local function guiChallenge()
    if not mt then return end
    local args = {
        [1] = {
            ["TargetUserId"] = mt.UserId,
            ["Event"] = "DuelRequest",
            ["Action"] = "Challenge"
        }
    }
    DuelRemote:FireServer(unpack(args))
end

local function guiAccept()
    if not chu then return end
    local args = {
        [1] = {
            ["ChallengerUserId"] = chu.UserId,
            ["Event"] = "DuelRequest",
            ["Action"] = "Accept"
        }
    }
    DuelRemote:FireServer(unpack(args))
end

-- ==================== TÍN HIỆU ẨN QUA ATTRIBUTE ====================
local function guiTinHieu()
    local c=player.Character if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart") if not hrp then return end
    pcall(function() hrp:SetAttribute("DuelSignal",tick()) end)
    task.delay(0.5,function() pcall(function() hrp:SetAttribute("DuelSignal",nil) end) end)
end

local function nhanTinHieu()
    if not chu or not chu.Character then return false end
    local hrp=chu.Character:FindFirstChild("HumanoidRootPart") if not hrp then return false end
    local signal=hrp:GetAttribute("DuelSignal")
    return signal and tonumber(signal) and tick()-tonumber(signal)<1
end

