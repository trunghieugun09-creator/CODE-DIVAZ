-- ==================== RING SYSTEM (CHỈ ACTIVE KHI Ở TRONG RING) ====================
local function trongRing()
    local c = player.Character
    if not c then return false end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    -- Kiểm tra nếu đang ở gần spawn
    if (hrp.Position - TOADO).Magnitude < 20 then
        return true
    end
    return false
end

local function fixSpawn()
    if not trongRing() then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" or obj.Name == "Spawn1" or obj.Name == "Spawn2" then
            if obj.ClassName == "SpawnLocation" then
                obj.Duration = 0
            end
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj.ClassName == "SpawnLocation" then
                obj.CFrame = CFrame.new(TOADO)
                obj.Velocity = Vector3.zero
                obj.Anchored = true
            end
        end
    end
end

-- Fix spawn mỗi frame NHƯNG CHỈ KHI Ở TRONG RING
RunService.RenderStepped:Connect(function()
    if not ringEnabled then return end
    if trongRing() then
        fixSpawn()
    end
end)

-- Kéo nhân vật về đúng vị trí NHƯNG CHỈ KHI Ở TRONG RING
RunService.RenderStepped:Connect(function()
    if not ringEnabled then return end
    if not trongRing() then return end
    
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
