local WebhookURL = ""
local webhookEnabled = false

local function getRequestFunction()
    if typeof(request) == "function" then
        return request
    end

    if typeof(http_request) == "function" then
        return http_request
    end

    if syn and typeof(syn.request) == "function" then
        return syn.request
    end

    if http and typeof(http.request) == "function" then
        return http.request
    end

    return nil
end

local function sendWebhook(title, message, color)
    if not webhookEnabled then
        warn("Webhook đang OFF")
        return false, "Webhook OFF"
    end

    if WebhookURL == nil or WebhookURL == "" then
        warn("WebhookURL trống")
        return false, "WebhookURL trống"
    end

    local requestFunc = getRequestFunction()

    if not requestFunc then
        warn("Không hỗ trợ Http")
        return false, "Không tìm thấy request function"
    end

    local embed = {
        ["title"] = title,
        ["description"] = message,
        ["color"] = color or 65280,
        ["timestamp"] = DateTime.now():ToIsoDate(),
        ["footer"] = {
            ["text"] = "DỊCH VỤ CÀY TIỀN - PAWLOVY"
        }
    }

    local data = {
        ["username"] = "PawLovY_Notification🔔",

        -- ĐỔI AVATAR BOT WEBHOOK Ở ĐÂY
        ["avatar_url"] = "https://cdn.discordapp.com/attachments/1523592927106961481/1539578156317671497/a750644174745cd906681830da3a3873.jpg?ex=6a86d364&is=6a8581e4&hm=1790432d05f96d7cc5781ab01171fdfaedbc41ea1c343477729332026baa8e7f&",

        ["embeds"] = {
            embed
        }
    }

    local encodeSuccess, encodeResult = pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if not encodeSuccess then
        warn("JSONEncode lỗi:", encodeResult)
        return false, tostring(encodeResult)
    end

    local success, response = pcall(function()
        return requestFunc({
            Url = WebhookURL,
            Method = "POST",

            Headers = {
                ["Content-Type"] = "application/json"
            },

            Body = encodeResult
        })
    end)

    if not success then
        warn("Webhook lỗi:", response)
        return false, tostring(response)
    end

    if response then
        local statusCode =
            response.StatusCode
            or response.Status

        if statusCode then
            local numericStatus =
                tonumber(statusCode)

            if numericStatus
                and numericStatus >= 400 then

                warn(
                    "Discord HTTP Error:",
                    statusCode
                )

                if response.Body then
                    warn(
                        "Discord Response:",
                        response.Body
                    )
                end

                return false, tostring(statusCode)
            end
        end
    end

    return true, response
end

