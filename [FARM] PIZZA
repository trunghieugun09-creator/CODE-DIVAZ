local function restartFarm()
    if not Enabled then
        return
    end

    if IsRestarting then
        return
    end

    IsRestarting = true
    IsBusy = false
    isEquipping = false

    UndergroundY =
        -HEAD_OFFSET

    CollectedMoneyList = {}
    MaskReady = false

    local waited = 0

    while Enabled
        and not isCharacterAlive()
        and waited < 30 do

        task.wait(0.5)

        waited =
            waited + 0.5
    end

    if not Enabled then
        IsRestarting = false
        return
    end

    if not isCharacterAlive() then
        Enabled = false
        IsRestarting = false

        if button and button.Parent then
            button.Text =
                "▶ START"

            button.BackgroundColor3 =
                Color3.fromRGB(
                    255,
                    100,
                    0
                )
        end

        return
    end

    goUnderground()
    setupSkiMask()

    IsRestarting = false

    task.spawn(function()
        pcall(function()
            farm()
        end)
    end)
end

RunService.Heartbeat:Connect(function()
    if not Enabled then
        return
    end

    if IsKicked then
        return
    end

    if IsRestarting then
        return
    end

    local char =
        player.Character

    if not char then
        restartFarm()
        return
    end

    local hum =
        char:FindFirstChildOfClass(
            "Humanoid"
        )

    local hrp =
        char:FindFirstChild(
            "HumanoidRootPart"
        )

    if hum and hum.Health <= 0 then
        restartFarm()
        return
    end

    if hrp
        and hrp.Position.Y < -200 then

        restartFarm()
        return
    end

    if Enabled
        and hrp
        and UndergroundY
        and not IsRestarting then

        if math.abs(
            hrp.Position.Y -
            UndergroundY
        ) > 2 then

            hrp.CFrame =
                CFrame.new(
                    hrp.Position.X,
                    UndergroundY,
                    hrp.Position.Z
                )

            hrp.Velocity =
                Vector3.new(
                    hrp.Velocity.X,
                    0,
                    hrp.Velocity.Z
                )
        end
    end

    if hum
        and not hum.PlatformStand then

        if hum.WalkSpeed ~= SPEED then
            hum.WalkSpeed = SPEED
        end
    end

    if NoclipOn and char then
        enableNoclip(char)
    end

    if Enabled
        and not isEquipping
        and not IsRestarting then

        local hasPizza = false

        for _, v in pairs(
            char:GetChildren()
        ) do

            if v:IsA("Tool")
                and v.Name == "PizzaJob" then

                hasPizza = true
                break
            end
        end

        if not hasPizza then
            task.spawn(function()
                forceEquipPizza()
            end)
        end
    end
end)

