local function calculateUndergroundY(
    zoneY
)
    return zoneY - HEAD_OFFSET
end

local function flyToTarget(
    targetPos,
    hum,
    hrp
)
    local startTime = tick()
    local lastPos = hrp.Position

    local stuckTime = 0
    local isWaiting = false
    local waitStartTime = 0

    local failedAttempts = 0
    local maxFailedAttempts = 3

    if not hum.PlatformStand then
        enableFreefall(hum)
    end

    if UndergroundY then
        hrp.CFrame =
            CFrame.new(
                hrp.Position.X,
                UndergroundY,
                hrp.Position.Z
            )

        hrp.Velocity =
            Vector3.zero
    end

    while Enabled
        and hrp
        and hrp.Parent do

        local currentPos =
            hrp.Position

        local flatCurrent =
            Vector3.new(
                currentPos.X,
                0,
                currentPos.Z
            )

        local flatTarget =
            Vector3.new(
                targetPos.X,
                0,
                targetPos.Z
            )

        local distance =
            (flatCurrent - flatTarget)
            .Magnitude

        if distance <= 1.5 then
            hrp.Velocity =
                Vector3.zero

            return true
        end

        if tick() - startTime > 5
            and not isWaiting then

            isWaiting = true
            waitStartTime = tick()

            hrp.Velocity =
                Vector3.zero

            if UndergroundY then
                hrp.CFrame =
                    CFrame.new(
                        hrp.Position.X,
                        UndergroundY,
                        hrp.Position.Z
                    )
            end
        end

        if isWaiting then
            hrp.Velocity =
                Vector3.zero

            if UndergroundY then
                hrp.CFrame =
                    CFrame.new(
                        hrp.Position.X,
                        UndergroundY,
                        hrp.Position.Z
                    )
            end

            if tick() - waitStartTime >= 2 then
                isWaiting = false
                startTime = tick()

                failedAttempts =
                    failedAttempts + 1

                if failedAttempts >=
                    maxFailedAttempts then

                    hrp.Velocity =
                        Vector3.zero

                    return false
                end
            end

            task.wait()
            continue
        end

        if tick() - startTime > 20 then
            hrp.Velocity =
                Vector3.zero

            return false
        end

        if distance > 200 then
            hrp.CFrame =
                CFrame.new(
                    targetPos.X,
                    UndergroundY,
                    targetPos.Z
                )

            hrp.Velocity =
                Vector3.zero

            startTime = tick()

            task.wait(0.5)

            continue
        end

        local direction =
            (flatTarget - flatCurrent)
            .Unit

        hrp.Velocity =
            Vector3.new(
                direction.X * FLY_SPEED,
                0,
                direction.Z * FLY_SPEED
            )

        if math.abs(
            hrp.Position.Y -
            UndergroundY
        ) > 0.5 then

            hrp.CFrame =
                CFrame.new(
                    hrp.Position.X,
                    UndergroundY,
                    hrp.Position.Z
                )

            hrp.Velocity =
                Vector3.new(
                    hrp.Velocity.X,
                    0,
                    hrp.Velocity.Z
                )
        end

        hum.AutoRotate = false

        if direction.Magnitude > 0.01 then
            hrp.CFrame =
                CFrame.lookAt(
                    hrp.Position,
                    Vector3.new(
                        hrp.Position.X
                            + direction.X,

                        hrp.Position.Y,

                        hrp.Position.Z
                            + direction.Z
                    )
                )
        end

        if (
            hrp.Position - lastPos
        ).Magnitude < 0.5 then

            stuckTime =
                stuckTime + 0.1

            if stuckTime >= 2 then
                antiStuck(hrp)
                stuckTime = 0
            end
        else
            stuckTime = 0
        end

        lastPos = hrp.Position

        task.wait()
    end

    hrp.Velocity =
        Vector3.zero

    return false
end

