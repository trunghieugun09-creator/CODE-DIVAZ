confirmButton.MouseButton1Click:Connect(
    function()

        local raw =
            inputBox.Text

        raw =
            string.gsub(
                raw,
                "%.",
                ""
            )

        raw =
            string.gsub(
                raw,
                "[^%d]",
                ""
            )

        local amount =
            tonumber(raw)

        if amount and amount > 0 then

            MoneyLimit = amount

            limitLabel.Text =
                "Hạn mức: " ..
                formatWithComma(
                    MoneyLimit
                )

            if LimitEnabled then

                local remaining =
                    MoneyLimit -
                    TotalEarned

                if remaining < 0 then
                    remaining = 0
                end

                if remaining > 0 then
                    remainingLabel.Text =
                        "Còn thiếu: " ..
                        formatWithComma(
                            remaining
                        )
                else
                    remainingLabel.Text =
                        "✅ Đã đạt hạn mức!"
                end
            end
        end

        popupFrame.Visible = false
    end
)

