local function setupSkiMask()
    if MaskReady then
        return true
    end

    local char =
        player.Character

    if not char then
        return false
    end

    if isMaskActivated() then
        MaskReady = true
        return true
    end

    local backpack =
        player:FindFirstChild(
            "Backpack"
        )

    if backpack then
        for _, v in pairs(
            backpack:GetChildren()
        ) do

            if v:IsA("Tool")
                and v.Name == "Ski Mask" then

                local hum =
                    char:FindFirstChild(
                        "Humanoid"
                    )

                if hum then
                    hum:EquipTool(v)

                    task.wait(0.5)

                    pcall(function()
                        v:Activate()
                    end)

                    task.wait(0.3)

                    MaskReady = true

                    return true
                end
            end
        end
    end

    pcall(function()
        local map =
            workspace:FindFirstChild(
                "Map"
            )

        if map then
            local purchasable =
                map:FindFirstChild(
                    "Purchasable"
                )

            if purchasable then
                local toolFolder =
                    purchasable:FindFirstChild(
                        "Tool"
                    )

                if toolFolder then
                    local skiMaskTool =
                        toolFolder:FindFirstChild(
                            "Ski Mask"
                        )

                    if skiMaskTool then
                        Remote:FireServer({
                            ["Event"] =
                                "PurchaseTool",

                            ["Tool"] =
                                skiMaskTool
                        })
                    end
                end
            end
        end
    end)

    local maskTool = nil

    for _ = 1, 15 do

        if backpack then
            for _, v in pairs(
                backpack:GetChildren()
            ) do

                if v:IsA("Tool")
                    and v.Name == "Ski Mask" then

                    maskTool = v
                    break
                end
            end
        end

        if maskTool then
            break
        end

        task.wait(0.2)
    end

    if not maskTool then
        return false
    end

    local hum =
        char:FindFirstChild(
            "Humanoid"
        )

    if hum then
        hum:EquipTool(maskTool)

        task.wait(0.5)

        pcall(function()
            maskTool:Activate()
        end)

        task.wait(0.3)
    end

    MaskReady = true

    return true
end

local function forceEquipPizza()
