farm = function()
    while Enabled do

        if IsKicked then
            return
        end

        if IsRestarting then
            task.wait(0.5)
            continue
        end

        if IsBusy then
            task.wait(0.3)
            continue
        end

        IsBusy = true

        if not isCharacterAlive() then
            IsBusy = false
            restartFarm()
            continue
        end

        if not player.Character
            or not player.Character:FindFirstChild(
                "HumanoidRootPart"
            ) then

            task.wait(1)

            IsBusy = false

            continue
        end

        forceEquipPizza()

        startJob()

        local prompt = nil
        local findStart = tick()

        repeat
            if not Enabled
                or IsRestarting then

                IsBusy = false
                return
            end

            if not isCharacterAlive() then
                IsBusy = false
                restartFarm()
                return
            end

            prompt =
                findDelivery()

            if prompt then
                break
            end

            task.wait(0.2)

        until tick() - findStart > 5

        if not prompt then
            IsBusy = false

            task.wait(0.5)

            continue
        end

        local char, hum, hrp =
            getChar()

        if not char
            or not hum
            or not hrp then

            IsBusy = false

            task.wait(1)

            continue
        end

        if not isCharacterAlive() then
            IsBusy = false
            restartFarm()
            continue
        end

        local targetPart =
            prompt.Parent

        if not targetPart
            or not targetPart:IsA(
                "BasePart"
            ) then

            IsBusy = false

            task.wait(0.5)

            continue
        end

        local targetPos =
            targetPart.Position

        UndergroundY =
            calculateUndergroundY(
                targetPos.Y
            )

        enableNoclip(char)
        enableFreefall(hum)

        hrp.CFrame =
            CFrame.new(
                hrp.Position.X,
                UndergroundY,
                hrp.Position.Z
            )

        hrp.Velocity =
            Vector3.zero

        local reached =
            flyToTarget(
                targetPos,
                hum,
                hrp
            )

        if not isCharacterAlive() then
            IsBusy = false
            restartFarm()
            continue
        end

        if not reached then
            IsBusy = false

            pcall(function()
                Remote:FireServer({
                    ["Event"] =
                        "CompletedJob",

                    ["Job"] =
                        "Pizza"
                })
            end)

            task.wait(0.5)

            forceEquipPizza()

            task.wait(0.5)

            continue
        end

        if Enabled
            and player.Character
            and hrp
            and hrp.Parent
            and isCharacterAlive() then

            triggerDelivery(
                prompt,
                hrp
            )

            task.wait(0.3)

            if Enabled
                and not IsRestarting
                and isCharacterAlive() then

                completeJobAndForceEquipPizza()

                task.wait(0.3)
            end

            collectAllNewMoney()

            -- Cập nhật tiền ngay sau khi nhận
            updateEarnedMoney()

            if IsKicked then
                IsBusy = false
                return
            end

            task.wait(0.2)

            if Enabled
                and not IsRestarting
                and isCharacterAlive() then

                startJob()

                forceEquipPizza()
            end

            task.wait(0.3)
        end

        IsBusy = false

        task.wait(0.1)
    end
end

local function startFarm()
    if not Enabled then
        return
    end

    goUnderground()

    setupSkiMask()

    farm()
end

