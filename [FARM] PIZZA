    "Text"
):Connect(function()

    local raw =
        inputBox.Text

    raw =
        string.gsub(
            raw,
            "%.",
            ""
        )

    raw =
        string.gsub(
            raw,
            "[^%d]",
            ""
        )

    if raw == "" then
        return
    end

    local num =
        tonumber(raw)

    if num then
        local formatted =
            formatWithComma(num)

        if inputBox.Text ~= formatted then
            inputBox.Text =
                formatted

            pcall(function()
                inputBox.CursorPosition =
                    #formatted + 1
            end)
        end
    end
