    workspace.Gravity = 0
end

local function disableFreefall(
    hum,
    hrp
)
    hum.PlatformStand = false
    hum.AutoRotate = true

    workspace.Gravity = 196.2

    if hrp then
        hrp.Velocity =
            Vector3.zero
    end

    hum.WalkSpeed = SPEED
end

local function antiStuck(hrp)
    hrp.Velocity =
        Vector3.new(
            150,
            0,
            0
        )

    task.wait(0.2)

    hrp.Velocity =
        Vector3.new(
            -150,
            0,
            0
        )

    task.wait(0.2)

    hrp.Velocity =
        Vector3.new(
            0,
            0,
            150
        )

    task.wait(0.2)

    hrp.Velocity =
        Vector3.new(
            0,
            0,
            -150
        )

    task.wait(0.2)

    hrp.Velocity =
        Vector3.zero
end

