local function updateEarnedMoney()
    local currentMoney =
        getBaseMoney()

    if lastKnownMoney == nil then
        lastKnownMoney = currentMoney
        return
    end

    local earned =
        currentMoney - lastKnownMoney

    -- Chỉ tính khi tiền tăng
    if earned > 0 then
        TotalEarned =
            TotalEarned + earned
    end

    lastKnownMoney =
        currentMoney

    -- Check hạn mức ngay lập tức
    if LimitEnabled
        and MoneyLimit > 0
        and TotalEarned >= MoneyLimit
        and not IsKicked then

        task.spawn(function()
            onLimitReached()
        end)
    end
end

local function resetMoneyCounter()
    lastKnownMoney =
        getBaseMoney()

    TotalEarned = 0
end

