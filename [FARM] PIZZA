local function getBaseMoney()
    local leaderstats =
        player:FindFirstChild("leaderstats")

    if not leaderstats then
        return 0
    end

    local moneyValue =
        leaderstats:FindFirstChild("Money")
        or leaderstats:FindFirstChild("Cash")
        or leaderstats:FindFirstChild("Dollars")
        or leaderstats:FindFirstChild("Points")
        or leaderstats:FindFirstChild("Coin")

    if moneyValue then
        local value =
            tonumber(moneyValue.Value)

        if value then
            return value
        end
    end

    return 0
end

local function formatMoney(amount)
    amount = tonumber(amount) or 0

    if amount >= 1000000 then
        return string.format(
            "%.1fM",
            amount / 1000000
        )

    elseif amount >= 1000 then
        return string.format(
            "%.0fk",
            amount / 1000
        )

    else
        return tostring(
            math.floor(amount)
        )
    end
end

local function formatWithComma(amount)
    amount = tonumber(amount) or 0

    local negative = amount < 0

    amount = math.abs(
        math.floor(amount)
    )

    local formatted = tostring(amount)
    local result = ""
    local count = 0

    for i = #formatted, 1, -1 do
        result =
            formatted:sub(i, i)
            .. result

        count = count + 1

        if count % 3 == 0
            and i > 1 then

            result = "." .. result
        end
    end

    if negative then
        result = "-" .. result
    end

    return result
end

local function formatTime(seconds)
    seconds = tonumber(seconds) or 0

    local hours =
        math.floor(seconds / 3600)

    local mins =
        math.floor(
            (seconds % 3600) / 60
        )

    local secs =
        math.floor(seconds % 60)

    return string.format(
        "%02d:%02d:%02d",
        hours,
        mins,
        secs
    )
end

local function checkMoneyLimit()
    if not LimitEnabled then
        return false
    end

    if MoneyLimit <= 0 then
        return false
    end

    return TotalEarned >= MoneyLimit
end

