        return false
    end

    isEquipping = true

    local result = false

    pcall(function()
        local char =
            player.Character

        if not char then
            return
        end

        local hum =
            char:FindFirstChild(
                "Humanoid"
            )

        if not hum then
            return
        end

        for _, v in pairs(
            char:GetChildren()
        ) do

            if v:IsA("Tool")
                and v.Name == "PizzaJob" then

                result = true
                return
            end
        end

        local pizza =
            findPizzaInInventory()

        if not pizza then
            return
        end

        local backpack =
            player:FindFirstChild(
                "Backpack"
            )

        for _, v in pairs(
            char:GetChildren()
        ) do

            if v:IsA("Tool")
                and v.Name ~= "Ski Mask" then

                if backpack then
                    v.Parent = backpack
                end
            end
        end

        task.wait(0.1)

        hum:EquipTool(pizza)

        task.wait(0.2)

        for _, v in pairs(
            char:GetChildren()
        ) do

            if v:IsA("Tool")
                and v.Name == "PizzaJob" then

                result = true
                return
            end
        end
    end)

    isEquipping = false

