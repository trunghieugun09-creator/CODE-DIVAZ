-- ==================== RING + SPAWN CỐ ĐỊNH ====================
local function dichSpawn()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" or obj.Name == "Spawn1" or obj.Name == "Spawn2" then
            if obj.ClassName == "SpawnLocation" then obj.Duration = 0 end
            if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj.ClassName == "SpawnLocation" then
                obj.CFrame = CFrame.new(TOADO_CHUNG) obj.Velocity = Vector3.zero obj.Anchored = true
            end
        end
    end
end
RunService.RenderStepped:Connect(dichSpawn)

RunService.RenderStepped:Connect(function()
    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - TOADO_CHUNG).Magnitude > 5 then
            hrp.CFrame = CFrame.new(TOADO_CHUNG) hrp.Velocity = Vector3.zero
        end
    end
end)

player.CharacterAdded:Connect(function(char)
    task.wait(0.1) local hrp = char:WaitForChild("HumanoidRootPart",5)
    if hrp then hrp.CFrame = CFrame.new(TOADO_CHUNG) end
    dichSpawn()
end)

workspace.DescendantAdded:Connect(function(obj)
    if obj.ClassName == "SpawnLocation" or obj.Name == "Spawn1" or obj.Name == "Spawn2" then
        if obj.ClassName == "SpawnLocation" then obj.Duration = 0 end
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj.ClassName == "SpawnLocation" then
            obj.Anchored = true obj.CFrame = CFrame.new(TOADO_CHUNG)
        end
    end
end)

-- ==================== NHẬN TÍN HIỆU ẨN ====================
task.spawn(function()
    while true do
        task.wait(0.1)
        if not dangHoatDong then nhanDuocTinHieu = false continue end
        if not accChu then continue end
        local tc = accChu.Character
        if not tc then continue end
        local hrp = tc:FindFirstChild("HumanoidRootPart")
        if hrp and math.abs(hrp.Position.Y - TIN_HIEU_Y) < 0.5 then
            nhanDuocTinHieu = true
        end
    end
end)

-- ==================== GỬI ACCEPT ====================
local function guiAccept()
    if not accChu then return end
    local args = {[1] = {["ChallengerUserId"] = accChu.UserId, ["Event"] = "DuelRequest", ["Action"] = "Accept"}}
    pcall(function() Remote:FireServer(unpack(args)) end)
end

-- ==================== VÒNG LẶP CHÍNH ====================
task.spawn(function()
    while true do
        task.wait(0.2)
        if not dangHoatDong then continue end
        if nhanDuocTinHieu then
            nhanDuocTinHieu = false
            task.wait(0.3)
            guiAccept()
        end
    end
end)

