local function capNhatDanhSach()
    for _, v in pairs(khungCuon:GetChildren()) do if v:IsA("Frame") then v:Destroy() end end
    for _, pl in pairs(Players:GetPlayers()) do if pl ~= player then
        local dong = Instance.new("Frame") dong.Size = UDim2.new(1, -6, 0, 44) dong.BackgroundColor3 = (accChu == pl) and Color3.fromRGB(0, 100, 180) or Color3.fromRGB(30, 30, 40) dong.BorderSizePixel = 0 dong.Parent = khungCuon
        Instance.new("UICorner", dong).CornerRadius = UDim.new(0, 8)
        local avt = Instance.new("ImageLabel") avt.Size = UDim2.new(0, 34, 0, 34) avt.Position = UDim2.new(0, 5, 0.5, -17) avt.BackgroundTransparency = 1 avt.Parent = dong
        Instance.new("UICorner", avt).CornerRadius = UDim.new(0, 17)
        pcall(function() avt.Image = Players:GetUserThumbnailAsync(pl.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) end)
        local ten = Instance.new("TextLabel") ten.Size = UDim2.new(0, 120, 0, 18) ten.Position = UDim2.new(0, 46, 0, 4) ten.Text = pl.DisplayName ten.TextColor3 = Color3.new(1, 1, 1) ten.Font = Enum.Font.GothamBold ten.TextSize = 12 ten.BackgroundTransparency = 1 ten.TextXAlignment = Enum.TextXAlignment.Left ten.Parent = dong
        local uid = Instance.new("TextLabel") uid.Size = UDim2.new(0, 120, 0, 14) uid.Position = UDim2.new(0, 46, 0, 24) uid.Text = "UID: " .. pl.UserId uid.TextColor3 = Color3.fromRGB(150, 150, 170) uid.Font = Enum.Font.Gotham uid.TextSize = 9 uid.BackgroundTransparency = 1 uid.TextXAlignment = Enum.TextXAlignment.Left uid.Parent = dong
        local ref = pl
        dong.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then accChu = ref capNhatDanhSach() end
        end)
    end end
    khungCuon.CanvasSize = UDim2.new(0, 0, 0, danhSach.AbsoluteContentSize.Y + 5)
end
