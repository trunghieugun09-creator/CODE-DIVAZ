-- DRAG AN TOÀN
local dangKeo, diemBatDau, viTriBatDau = nil, nil, nil
khungChinh.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        if dangKeo then return end dangKeo = input diemBatDau = input.Position viTriBatDau = khungChinh.Position
    end
end)
UIS.InputEnded:Connect(function(input) if input == dangKeo then dangKeo, diemBatDau, viTriBatDau = nil, nil, nil end end)
UIS.InputChanged:Connect(function(input)
    if input == dangKeo then local delta = input.Position - diemBatDau khungChinh.Position = UDim2.new(viTriBatDau.X.Scale, viTriBatDau.X.Offset + delta.X, viTriBatDau.Y.Scale, viTriBatDau.Y.Offset + delta.Y) end
end)

