-- Hồi sinh
local function dichSpawn()
    local count = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" then
            pcall(function()
                obj.CFrame = CFrame.new(TOA_DO_SPAWN)
                obj.Duration = 0
            end)
            count = count + 1
        end
    end
    return count
end

