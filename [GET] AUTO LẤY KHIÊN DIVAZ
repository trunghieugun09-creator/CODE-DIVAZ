-- Move
local function moveTo(targetPos)
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end
    hum:MoveTo(targetPos)
    local timeout = 15
    local waited = 0
    while isRunning and waited < timeout do
        local dist = (hrp.Position - targetPos).Magnitude
        if dist < 3 then return true end
        hum:MoveTo(targetPos)
        task.wait(0.5)
        waited = waited + 0.5
    end
    return false
end

-- Tìm ProximityPrompt theo ActionText
local function findPromptByActionText(actionText)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.ActionText == actionText then
            return v
        end
    end
    return nil
end

-- Tìm ProximityPrompt Loot
local function findLootPrompt()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if v.ActionText == "Loot" or v.Name == "Loot" then
                return v
            end
        end
    end
    return nil
end

-- Kiểm tra prompt đã dùng hay chưa
local function isPromptUsed(prompt)
    if not prompt then return true end
    if prompt.Enabled == false then return true end
    if prompt.ActionText == "" then return true end
    if prompt.Parent and prompt.Parent:IsA("BasePart") then
        if prompt.Parent.Transparency >= 0.9 then return true end
    end
    return false
end

-- Giữ ProximityPrompt cho đến khi đã dùng
local function holdPromptUntilUsed(prompt)
    pcall(function()
        prompt:InputHoldBegin()
    end)
    local waited = 0
    while isRunning and waited < 30 do
        if isPromptUsed(prompt) then
            pcall(function()
                prompt:InputHoldEnd()
            end)
            return true
        end
        pcall(function()
            prompt:InputHoldBegin()
        end)
        task.wait(0.1)
        waited = waited + 0.1
    end
    pcall(function()
        prompt:InputHoldEnd()
    end)
    return false
end

-- Lấy thời gian game
local function getGameTime()
    local minutesAfterMidnight = Lighting:GetMinutesAfterMidnight()
    local hours = math.floor(minutesAfterMidnight / 60)
    local minutes = math.floor(minutesAfterMidnight % 60)
    return hours, minutes
end

-- Nhấn Loot bằng ProximityPrompt
local function pressLoot(prompt)
    pcall(function()
        prompt:InputHoldBegin()
        task.wait(0.15)
        prompt:InputHoldEnd()
    end)
    return true
end

-- Main loop
local function mainLoop()
    while isRunning do
        -- Chờ đến 17:55
        while isRunning do
            local hours, minutes = getGameTime()
            if hours == 17 and minutes >= 55 then break end
            task.wait(1)
        end

        -- Move đến cửa ngân hàng
        moveTo(TOA_DO_CUA)

        -- Chờ đến 18:00
        while isRunning do
            local hours, minutes = getGameTime()
            if hours == 18 and minutes >= 0 then break end
            task.wait(1)
        end

        task.wait(0.5)

        local vaultPrompt = findPromptByActionText("Unlock Vault")
        if not vaultPrompt then
            task.wait(1)
            continue
        end

        -- Vòng lặp mở cửa + loot
        local looted = false
        local attemptCount = 0

        while isRunning and not looted and attemptCount < 3 do
            -- Giữ Unlock Vault cho đến khi prompt đã dùng
            holdPromptUntilUsed(vaultPrompt)

            -- Chờ tìm ProximityPrompt Loot
            local waitedLoot = 0
            local lootPrompt = nil
            while isRunning and waitedLoot < 3 do
                lootPrompt = findLootPrompt()
                if lootPrompt then break end
                task.wait(0.3)
                waitedLoot = waitedLoot + 0.3
            end

            -- Move đến toạ độ Loot
            if isRunning then
                moveTo(TOA_DO_LOOT)
                task.wait(0.3)
            end

            -- Thử nhấn Loot
            if isRunning and lootPrompt then
                pressLoot(lootPrompt)
                looted = true
                lootCount = lootCount + 1
                LootLabel.Text = "Loot: " .. lootCount
            end

            -- Nếu chưa loot được thì quay lại mở cửa
            if not looted then
                moveTo(TOA_DO_CUA)
                task.wait(0.3)
                vaultPrompt = findPromptByActionText("Unlock Vault")
                if not vaultPrompt then break end
            end

            attemptCount = attemptCount + 1
        end

        task.wait(1)
    end
end

