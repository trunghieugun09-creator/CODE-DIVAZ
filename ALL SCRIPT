local function lay_tien_goc()
    local ls = nguoi_choi:FindFirstChild("leaderstats")
    if ls then
        local mv = ls:FindFirstChild("Money") or ls:FindFirstChild("Cash") or ls:FindFirstChild("Dollars") or ls:FindFirstChild("Points") or ls:FindFirstChild("Coin")
        if mv then return mv.Value end
    end
    return 0
end

local function kiem_tra_tool_trong_balo()
    local backpack = nguoi_choi:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if n:find("flick") or n:find("nails") then return true end
        end
    end
    return false
end

local function quay_mong()
    pcall(function()
        local before = lay_tien_goc()
        local args = {
            [1] = {
                ["Event"] = "SpinWeaponWheel"
            }
        }
        game:GetService("ReplicatedStorage").Event:FireServer(unpack(args))
        task.wait(.2)
        local after = lay_tien_goc()
        local diff = before - after
        if diff > 0 then
            tien_quay_mong += diff
        else
            tien_quay_mong += 1000
        end
        lan_quay_mong += 1
    end)
end

local function vong_lap_quay_mong()
    while tu_quay_mong do
        if kiem_tra_tool_trong_balo() then
            tu_quay_mong = false
            break
        end
        local current_money = lay_tien_goc()
        if current_money >= 1000 then
            quay_mong()
            task.wait(.5)
        else
            task.wait(1)
        end
    end
end

local function quay_thung()
