local function tween_gui(ts, tp, cr)
    if curTween then curTween:Cancel() end
    local ti = TweenInfo.new(.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local sT = TweenService:Create(MF, ti, {Size = ts})
    sT:Play()
    TweenService:Create(MF, ti, {Position = tp}):Play()
    TweenService:Create(MFC, ti, {CornerRadius = cr}):Play()
    curTween = sT
    sT.Completed:Connect(function()
        curTween = nil
    end)
end

