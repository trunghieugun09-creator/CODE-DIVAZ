local function getBaseMoney()
    local leaderstats = nguoi_choi:FindFirstChild("leaderstats")
    if leaderstats then
        local moneyValue = leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash") or leaderstats:FindFirstChild("Dollars") or leaderstats:FindFirstChild("Points") or leaderstats:FindFirstChild("Coin")
        if moneyValue then return moneyValue.Value end
    end
    return 0
end

local function kiemTraToolTrongBackpack()
    local backpack = nguoi_choi:FindFirstChild("Backpack")
    if not backpack then return false end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local tenTool = tool.Name:lower()
            if tenTool:find("flick") or tenTool:find("nails") then
                return true
            end
        end
    end
    return false
end

local function spinNails()
    pcall(function()
        local before = getBaseMoney()
        local args = { [1] = { ["Event"] = "SpinWeaponWheel" } }
        game:GetService("ReplicatedStorage").Event:FireServer(unpack(args))
        task.wait(0.2)
        local after = getBaseMoney()
        local diff = before - after
        if diff > 0 then money_spent_nails = money_spent_nails + diff else money_spent_nails = money_spent_nails + 1000 end
        spin_count_nails = spin_count_nails + 1
    end)
end

local function autoSpinNailsLoop()
    while auto_spin_on do
        if kiemTraToolTrongBackpack() then
            auto_spin_on = false
            break
        end
        local current_money = getBaseMoney()
        if current_money >= 1000 then spinNails() task.wait(0.5) else task.wait(1) end
    end
end

local function spinCrate()
    pcall(function()
        local before = getBaseMoney()
        local args = { [1] = { ["Event"] = "SpinWeaponCrate", ["Crate"] = "Elemental Weapon Crate" } }
        game:GetService("ReplicatedStorage").Event:FireServer(unpack(args))
        task.wait(0.2)
        local after = getBaseMoney()
        local diff = before - after
        if diff > 0 then money_spent_crate = money_spent_crate + diff else money_spent_crate = money_spent_crate + 8000 end
        spin_count_crate = spin_count_crate + 1
    end)
end

local function autoSpinCrateLoop()
    while auto_spin_crate_on do
        local current_money = getBaseMoney()
        if current_money >= 8000 then spinCrate() task.wait(0.5) else task.wait(1) end
    end
end

