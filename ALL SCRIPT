local function captureOriginalSpawns()
    originalSpawnCFrames = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" then originalSpawnCFrames[obj] = obj.CFrame end
    end
end

local function setSpawnToBank()
    captureOriginalSpawns()
    spawnOverridden = true
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" then
            pcall(function() obj.CFrame = CFrame.new(TOA_DO_SPAWN) obj.Duration = 0 end)
        end
    end
end

local function restoreOriginalSpawns()
    if not spawnOverridden then return end
    spawnOverridden = false
    for obj, cf in pairs(originalSpawnCFrames) do
        pcall(function() obj.CFrame = cf obj.Duration = 0 end)
    end
    originalSpawnCFrames = {}
end

local function bankGetTime()
    local minutesAfterMidnight = Lighting:GetMinutesAfterMidnight()
    local hours = math.floor(minutesAfterMidnight / 60)
    local minutes = math.floor(minutesAfterMidnight % 60)
    return hours, minutes
end

local function isInBankTimeWindow()
    local hours, minutes = bankGetTime()
    local totalMinutes = hours * 60 + minutes
    local startWindow = 18 * 60
    local endWindow = 7 * 60
    if totalMinutes >= startWindow then return true end
    if totalMinutes < endWindow then return true end
    return false
end

local function bankMoveTo(targetPos)
    local char = nguoi_choi.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    hum:MoveTo(targetPos)
    local timeout = 15
    local waited = 0
    while auto_bank_on and waited < timeout do
        local dist = (hrp.Position - targetPos).Magnitude
        if dist < 3 then return true end
        hum:MoveTo(targetPos)
        task.wait(0.5)
        waited = waited + 0.5
    end
    return false
end

local function bankFindPrompt(actionText)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.ActionText == actionText then return v end
    end
    return nil
end

local function bankFindLoot()
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if v.ActionText == "Loot" or v.Name == "Loot" then return v end
        end
    end
    return nil
end

local function bankIsPromptUsed(prompt)
    if not prompt then return true end
    if prompt.Enabled == false then return true end
    if prompt.ActionText == "" then return true end
    if prompt.Parent and prompt.Parent:IsA("BasePart") then
        if prompt.Parent.Transparency >= 0.9 then return true end
    end
    return false
end

local function bankHoldPrompt(prompt)
    pcall(function() prompt:InputHoldBegin() end)
    local waited = 0
    while auto_bank_on and waited < 30 do
        if bankIsPromptUsed(prompt) then
            pcall(function() prompt:InputHoldEnd() end)
            return true
        end
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(0.1)
        waited = waited + 0.1
    end
    pcall(function() prompt:InputHoldEnd() end)
    return false
end

local function bankPressLoot(prompt)
    pcall(function() prompt:InputHoldBegin() task.wait(0.15) prompt:InputHoldEnd() end)
    return true
end

local function bankMainLoop()
    if bank_running then return end
    bank_running = true
    setSpawnToBank()
    while auto_bank_on do
        while auto_bank_on do
            if isInBankTimeWindow() then break end
            task.wait(1)
        end
        if not auto_bank_on then break end

        bankMoveTo(TOA_DO_CUA)

        local vaultPrompt = bankFindPrompt("Unlock Vault")
        if not vaultPrompt then
            task.wait(1)
            continue
        end

        local looted = false
        local attemptCount = 0

        while auto_bank_on and not looted and attemptCount < 3 and isInBankTimeWindow() do
            bankHoldPrompt(vaultPrompt)

            local waitedLoot = 0
            local lootPrompt = nil
            while auto_bank_on and waitedLoot < 3 do
                lootPrompt = bankFindLoot()
                if lootPrompt then break end
                task.wait(0.3)
                waitedLoot = waitedLoot + 0.3
            end

            if auto_bank_on and lootPrompt then
                bankMoveTo(TOA_DO_LOOT)
                task.wait(0.3)
                bankPressLoot(lootPrompt)
                looted = true
                loot_count = loot_count + 1
                break
            end

            if not looted then
                bankMoveTo(TOA_DO_CUA)
                task.wait(0.3)
                vaultPrompt = bankFindPrompt("Unlock Vault")
                if not vaultPrompt then break end
            end

            attemptCount = attemptCount + 1
        end

        while auto_bank_on and isInBankTimeWindow() do
            task.wait(5)
        end
    end
    restoreOriginalSpawns()
    bank_running = false
end

