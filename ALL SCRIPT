local function TweenGUI(ts, tp, cr)
    if curTween then curTween:Cancel() end
    local ti = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local sT = TweenService:Create(MF, ti, {Size = ts})
