local function luu_spawn_goc()
    spawn_goc = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" then
            spawn_goc[obj] = obj.CFrame
        end
    end
end

local function dat_spawn_ngan_hang()
    luu_spawn_goc()
    da_override_spawn = true
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.ClassName == "SpawnLocation" then
            pcall(function()
                obj.CFrame = CFrame.new(toa_do_spawn)
                obj.Duration = 0
            end)
        end
    end
end

local function khoi_phuc_spawn()
    if not da_override_spawn then return end
    da_override_spawn = false
    for obj, cf in pairs(spawn_goc) do
        pcall(function()
            obj.CFrame = cf
            obj.Duration = 0
        end)
    end
    spawn_goc = {}
end

local function lay_gio_game()
    local m = Lighting:GetMinutesAfterMidnight()
    local h = math.floor(m / 60)
    local mi = math.floor(m % 60)
    return h, mi
end

local function trong_khung_gio_cuop()
    local h, mi = lay_gio_game()
    local t = h * 60 + mi
    if t >= 1080 then return true end
    if t < 420 then return true end
    return false
end

local function di_chuyen_den(targetPos)
    local char = nguoi_choi.Character
    if not char then return false end
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end
    hum:MoveTo(targetPos)
    local waited = 0
    while tu_cuop_ngan_hang and waited < 15 do
        if (hrp.Position - targetPos).Magnitude < 3 then return true end
        hum:MoveTo(targetPos)
        task.wait(.5)
        waited += .5
    end
    return false
end

local function tim_prompt_theo_hanh_dong(actionText)
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and v.ActionText == actionText and v.Enabled == true then
            return v
        end
    end
end

local function tim_prompt_loot()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") and (v.ActionText == "Loot" or v.Name == "Loot") and v.Enabled == true then
            return v
        end
    end
end

local function loot_dang_hien()
    local p = tim_prompt_loot()
    if p then return true, p end
    return false, nil
end

local function giu_prompt(prompt)
    pcall(function()
        prompt:InputHoldBegin()
    end)
    local waited = 0
    while tu_cuop_ngan_hang and waited < 30 do
        local visible, p = loot_dang_hien()
        if visible and p then
            pcall(function()
                prompt:InputHoldEnd()
            end)
            return true
        end
        task.wait(.1)
        waited += .1
    end
    pcall(function()
        prompt:InputHoldEnd()
    end)
    return false
end

local function nhan_loot(prompt)
    pcall(function()
        task.wait(1)
        prompt:InputHoldBegin()
        task.wait(.5)
        prompt:InputHoldEnd()
    end)
end

local function vong_lap_cuop()
    if dang_cuop then return end
    dang_cuop = true
    dat_spawn_ngan_hang()
    while tu_cuop_ngan_hang do
        while tu_cuop_ngan_hang do
            if trong_khung_gio_cuop() then break end
            task.wait(1)
        end
        if not tu_cuop_ngan_hang then break end
        local da_loot = false
        local so_lan_thu = 0
        while tu_cuop_ngan_hang and not da_loot and so_lan_thu < 3 and trong_khung_gio_cuop() do
            local visible, lootPrompt = loot_dang_hien()
            if visible and lootPrompt then
                di_chuyen_den(toa_do_loot)
                task.wait(.3)
                nhan_loot(lootPrompt)
                da_loot = true
                lan_cuop += 1
                break
            end
            di_chuyen_den(toa_do_cua)
            local vaultPrompt = tim_prompt_theo_hanh_dong("Unlock Vault")
            if not vaultPrompt then
                task.wait(1)
                break
            end
            giu_prompt(vaultPrompt)
            local waitedLoot = 0
            lootPrompt = nil
            while tu_cuop_ngan_hang and waitedLoot < 5 do
                local tv, tp = loot_dang_hien()
                if tv and tp then
                    lootPrompt = tp
                    break
                end
                task.wait(.3)
                waitedLoot += .3
            end
            if tu_cuop_ngan_hang and lootPrompt then
                di_chuyen_den(toa_do_loot)
                task.wait(.3)
                nhan_loot(lootPrompt)
                da_loot = true
                lan_cuop += 1
                break
            end
            so_lan_thu += 1
        end
        while tu_cuop_ngan_hang and trong_khung_gio_cuop() do
            task.wait(5)
        end
    end
    khoi_phuc_spawn()
    dang_cuop = false
end

