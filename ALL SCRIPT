local isMin, curTween = false, nil
local bigPos = MF.Position
local smallPos = UDim2.new(bigPos.X.Scale, bigPos.X.Offset + 224, bigPos.Y.Scale, bigPos.Y.Offset + 134)

local function TweenGUI(ts, tp, cr)
    if curTween then curTween:Cancel() end
    local ti = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local sT = TweenService:Create(MF, ti, {Size = ts})
    sT:Play()
    TweenService:Create(MF, ti, {Position = tp}):Play()
    TweenService:Create(MFC, ti, {CornerRadius = cr}):Play()
    curTween = sT
    sT.Completed:Connect(function() curTween = nil end)
end

local function Minimize()
    if isMin then return end
    isMin = true
    bigPos = MF.Position
    TweenGUI(UDim2.new(0, 52, 0, 52), smallPos, UDim.new(0, 10))
    SB.Visible = false
    CA.Visible = false
    TT.Visible = false
    ClsB.Visible = false
    MinB.Visible = false
